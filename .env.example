# ============================================
# ⚙️  إعدادات البيئة — انسخ هذا الملف إلى .env
# ============================================

# --- التطبيق ---
APP_NAME="AI Platform"
APP_ENV=development          # development | staging | production
APP_DEBUG=true
APP_SECRET_KEY=change-this-to-a-very-long-random-secret-key-min-32-chars
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# --- قاعدة البيانات ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=platform_user
POSTGRES_PASSWORD=platform_pass
POSTGRES_DB=platform_db
DATABASE_URL=postgresql+asyncpg://platform_user:platform_pass@postgres:5432/platform_db

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- JWT ---
JWT_SECRET_KEY=change-this-jwt-secret-key-min-32-characters-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Claude AI (Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-your-api-key-here
CLAUDE_DEFAULT_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=4096

# --- MinIO (تخزين الملفات) ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=platform-files
MINIO_SECURE=false

# --- InfluxDB (بيانات الشبكة) ---
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=platform-influx-token
INFLUXDB_ORG=platform
INFLUXDB_BUCKET=network_metrics

# --- Chroma (Vector DB) ---
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# --- البريد الإلكتروني ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAILS_FROM_EMAIL=noreply@yourplatform.com
EMAILS_FROM_NAME="AI Platform"

# --- الأمان ---
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# --- التسجيل ---
LOG_LEVEL=INFO
SENTRY_DSN=
