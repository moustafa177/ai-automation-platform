# ═══════════════════════════════════════════════════════════
# AI Platform — Environment Variables Example
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ═══════════════════════════════════════════════════════════

# ── Application ─────────────────────────────────────────────
APP_NAME=AI Platform
APP_ENV=development          # development | staging | production
APP_DEBUG=true               # false in production
APP_SECRET_KEY=change-this-to-a-very-long-random-secret-key-min-32-chars
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────────────
# Development (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# Production (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/platform_db
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=platform_user
# POSTGRES_PASSWORD=your_secure_password
# POSTGRES_DB=platform_db

# ── JWT Authentication ────────────────────────────────────────
JWT_SECRET_KEY=change-this-jwt-secret-key-min-32-chars-random
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── AI — Anthropic Claude ────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_DEFAULT_MODEL=claude-sonnet-4-5

# ── AI — Google Gemini ───────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_DEFAULT_MODEL=models/gemini-2.5-flash

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ── Email (optional) ─────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAILS_FROM_EMAIL=noreply@yourplatform.com
EMAILS_FROM_NAME=AI Platform

# ── Redis (optional, for caching & Celery) ───────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── MinIO / S3 (optional, for file storage) ──────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_secret
MINIO_BUCKET_NAME=platform-files
MINIO_SECURE=false

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
SENTRY_DSN=                  # optional Sentry DSN
